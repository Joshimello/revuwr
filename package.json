{
  "name": "with-svelte",
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "turbo": "^2.9.16",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5",
  "private": true,
  "overrides": {
    "axios": "1.19.0",
    "flatted": "3.4.3",
    "form-data": "4.0.6",
    "immutable": "5.1.9",
    "js-cookie": "3.0.8",
    "js-yaml": "4.3.0",
    "jws": "3.2.3",
    "linkify-it": "5.0.2",
    "markdown-it": "14.3.0",
    "postcss": "8.5.25",
    "sha.js": "2.4.12",
    "tar-fs": "2.1.5",
    "undici": "7.28.0",
    "ws": "8.21.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write ."
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "docs/*"
  ]
